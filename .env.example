# 이 파일을 .env로 복사해 값을 채운다:  cp .env.example .env
# .env는 .gitignore에 들어 있어 커밋되지 않는다.

# JWT 서명키(Base64, 64바이트 이상 권장). 예전 키는 공개 이력에 노출됐으므로 절대 재사용하지 않는다.
#   macOS/Linux/Git Bash: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# docker compose의 MySQL 계정 (root는 MYSQL_USER로 쓸 수 없다)
DB_USERNAME=exerciting
DB_PASSWORD=
DB_ROOT_PASSWORD=

# MySQL 포트. 이미 로컬 MySQL이 3306을 쓰고 있다면 3307로 바꾸고 DB_URL의 포트도 같이 바꾼다.
DB_PORT=3306
DB_URL=jdbc:mysql://localhost:3306/exerciting_db?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&rewriteBatchedStatements=true

# 로컬 http 개발에서는 false, 운영(https)에서는 true
COOKIE_SECURE=false
SHOW_SQL=false
